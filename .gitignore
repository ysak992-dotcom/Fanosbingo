logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Secrets. VITE_* vars are compile-time, so a leaked .env leaks the build config.
.env
.env.*
!.env.example

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# Real variable values stay local; commit terraform.tfvars.example instead.
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Plan files can contain secret values in cleartext.
*.tfplan


# Bootstrap handoff. Contains the AWS account id; not secret, not repo content.
.bootstrap-output.json

# Service dependencies are installed in the image, not committed.
services/*/node_modules

# Built SPA, assembled in CI and baked into the Caddy image. Never committed.
services/caddy/public/*
!services/caddy/public/.gitkeep
summary.md
