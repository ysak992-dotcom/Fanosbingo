#!/bin/bash
set -euo pipefail
exec > >(tee /var/log/fanosbingo-bootstrap.log | logger -t bootstrap -s 2>/dev/console) 2>&1

echo "=== Fanos Bingo container instance bootstrap ==="

# ---------------------------------------------------------------------------
# 1. Join the ECS cluster
# ---------------------------------------------------------------------------
cat >> /etc/ecs/ecs.config <<EOF
ECS_CLUSTER=${cluster_name}
ECS_ENABLE_CONTAINER_METADATA=true
ECS_ENABLE_SPOT_INSTANCE_DRAINING=true
ECS_CONTAINER_STOP_TIMEOUT=30s
ECS_IMAGE_PULL_BEHAVIOR=prefer-cached
EOF

# ---------------------------------------------------------------------------
# 2. Swap
#
# The Realtime container (Elixir/BEAM) is the memory-hungry one at ~400 MB.
# Total steady-state footprint is ~1.03 GB of the 2 GB on t4g.small, so this is
# headroom rather than a crutch — but an OOM kill during a join spike would take
# the game down, and swap turns that into a slowdown instead.
# ---------------------------------------------------------------------------
if [ ! -f /swapfile ]; then
  echo "Creating ${swap_size_mb}MB swapfile"
  dd if=/dev/zero of=/swapfile bs=1M count=${swap_size_mb} status=none
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
  # Prefer reclaiming page cache over swapping application memory.
  sysctl -w vm.swappiness=10
  echo 'vm.swappiness=10' > /etc/sysctl.d/99-swappiness.conf
fi

# ---------------------------------------------------------------------------
# 3. Re-attach the Elastic IP
#
# The ASG replaces a failed instance with a brand-new one that has a brand-new
# public IP. Re-associating the environment's Elastic IP here means recovery
# needs no DNS change and no human — Cloudflare keeps pointing at the same
# address throughout.
# ---------------------------------------------------------------------------
if ! command -v aws >/dev/null 2>&1; then
  echo "AWS CLI missing; installing"
  dnf install -y awscli-2 || dnf install -y aws-cli || true
fi

TOKEN=$(curl -sX PUT "http://169.254.169.254/latest/api/token" \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" \
  http://169.254.169.254/latest/meta-data/instance-id)

echo "Associating EIP ${eip_allocation_id} with $INSTANCE_ID"
if aws ec2 associate-address \
  --region ${region} \
  --instance-id "$INSTANCE_ID" \
  --allocation-id ${eip_allocation_id} \
  --allow-reassociation; then
  echo "EIP associated"
else
  # Loud, because the symptom otherwise is "the site is down and I don't know
  # why": the instance is healthy and serving, just not on the address
  # Cloudflare resolves to.
  echo "ERROR: EIP association FAILED. The instance is running but unreachable"
  echo "ERROR: at the expected address. Check the instance role's"
  echo "ERROR: ec2:AssociateAddress permission and the Environment tag condition."
fi

# ---------------------------------------------------------------------------
# 4. Host metrics
#
# WHY NOT THE CLOUDWATCH AGENT. It is the obvious answer and it is the wrong one
# at this budget: the agent is another package to install and keep patched,
# another config file to get wrong, and its default configuration publishes a
# dozen metrics at $0.30 each. This publishes exactly TWO, using the AWS CLI that
# is already installed above for the Elastic IP association.
#
#   2 metrics + 2 alarms  ~= $0.80/month
#   PutMetricData calls   ~= $0.09/month at one call every five minutes
#
# WHAT WAS BLIND WITHOUT IT. `monitoring { enabled = false }` on the launch
# template means five-minute basic metrics, and basic EC2 metrics do not include
# memory or disk at all -- AWS cannot see inside the instance. So the box running
# all five containers, with ~1.03 GiB of steady-state usage against 2 GiB and a
# 30 GiB volume accumulating container images, had no memory or disk signal
# whatsoever. An OOM kill showed up only as whichever container-specific alarm
# happened to notice, and a filling disk would have shown up as PostgreSQL
# refusing writes.
#
# MEMORY IS MEASURED AS (total - available), not (total - free). `free` counts
# page cache as used, which on a box doing container I/O sits near 100% forever
# and would make the metric useless. `available` is the kernel's own estimate of
# what a new process could actually get.
#
# Failures are deliberately not fatal to the boot. A metric that cannot publish
# must not be the reason an instance fails to join the cluster.
# ---------------------------------------------------------------------------
cat > /usr/local/bin/publish-host-metrics.sh <<'SCRIPT'
#!/bin/bash
set -uo pipefail

REGION="${region}"
NAMESPACE="${metric_namespace}"
ENVIRONMENT="${environment}"

# Percent of memory genuinely unavailable to a new process.
mem=$(free | awk '/^Mem:/ {printf "%.1f", ($2 - $7) / $2 * 100}')

# Root volume. Holds container images and the swapfile; when it fills,
# PostgreSQL is not the thing that breaks first, the container runtime is.
disk=$(df --output=pcent / | tail -1 | tr -dc '0-9')

[ -z "$mem" ] && exit 0
[ -z "$disk" ] && exit 0

# DIMENSIONS TAKE A LIST OF STRUCTURES, NOT Key=Value.
#
# This shipped as `Dimensions=Environment=$ENVIRONMENT`, which reads naturally
# and is rejected by the CLI before the call is made:
#
#   Invalid type for parameter MetricData[0].Dimensions[0],
#   value: Environment=dev, type: <class 'str'>, valid types: <class 'dict'>
#
# The timer ran on schedule, the script exited 0 because the `||` swallowed it,
# and no metric was ever published. Found by looking for the datapoint after an
# instance refresh rather than by trusting that the timer was active -- which it
# was, faithfully failing every five minutes.
aws cloudwatch put-metric-data \
  --region "$REGION" \
  --namespace "$NAMESPACE" \
  --metric-data \
    "MetricName=MemoryUsedPercent,Value=$mem,Unit=Percent,Dimensions=[{Name=Environment,Value=$ENVIRONMENT}]" \
    "MetricName=DiskUsedPercent,Value=$disk,Unit=Percent,Dimensions=[{Name=Environment,Value=$ENVIRONMENT}]" \
  || echo "publish-host-metrics: put-metric-data FAILED"
SCRIPT
chmod +x /usr/local/bin/publish-host-metrics.sh

# systemd rather than cron: AL2023 ships systemd and does not ship crond.
cat > /etc/systemd/system/host-metrics.service <<'UNIT'
[Unit]
Description=Publish host memory and disk usage to CloudWatch

[Service]
Type=oneshot
ExecStart=/usr/local/bin/publish-host-metrics.sh
UNIT

# Five minutes, matching the basic-monitoring cadence the rest of this instance
# reports at. Persistent=true so a missed run after a reboot fires promptly
# rather than waiting out the full interval.
cat > /etc/systemd/system/host-metrics.timer <<'UNIT'
[Unit]
Description=Publish host metrics every five minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now host-metrics.timer || echo "WARNING: host-metrics.timer did not start"

# Publish once immediately, so the alarms have a datapoint without waiting for
# the first timer tick. They treat missing data as breaching.
/usr/local/bin/publish-host-metrics.sh || true

echo "=== bootstrap complete ==="
