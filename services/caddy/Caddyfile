# Caddy: TLS termination and routing.
#
# Runs in HOST network mode so it owns :443 on the instance directly, and
# proxies to the other containers at fixed 127.0.0.1 ports (they use bridge
# networking with static host port bindings).
#
# TLS uses a Cloudflare Origin Certificate rather than Let's Encrypt. Cloudflare
# is the only client that ever reaches this origin -- the security group admits
# 443 solely from Cloudflare's published ranges -- so a certificate trusted by
# Cloudflare is exactly the right trust anchor. It also avoids an ACME challenge
# on a host that is deliberately unreachable from the public internet.
#
# Cloudflare SSL mode must be FULL (STRICT).

{
	# No ACME: the certificate is supplied, not issued.
	auto_https disable_redirects
	admin off

	log {
		output stdout
		format json
		level INFO
	}
}

# ---------------------------------------------------------------------------
# API: PostgREST and the ported edge functions
# ---------------------------------------------------------------------------
https://api.{$DOMAIN}:{$HTTPS_PORT:443} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	# THE WEBHOOK SECRET MUST NOT BE LOGGED, AND BY DEFAULT IT WAS.
	#
	# Caddy's access log records every request header. It redacts Authorization
	# and Cookie on its own, so player JWTs were never exposed -- but it knows
	# nothing about X-Telegram-Bot-Api-Secret-Token, so every genuine Telegram
	# delivery wrote the shared secret into CloudWatch in plaintext. Observed on
	# prod on 2026-08-11, in the log line of a request made to test the route.
	#
	# That header IS the only authentication on /telegram/webhook -- the handler
	# refuses a missing one precisely because a forger simply omits it -- so
	# anyone who can read the log group can forge updates to the bot. Reachable
	# only by a principal with CloudWatch Logs read today (the scoped deploy
	# roles are implicitDeny), which bounds it rather than excusing it: a secret
	# whose whole job is to be unguessable does not belong in a log that exists
	# to be read.
	#
	# `delete` rather than `hash`: nothing is served by knowing that two requests
	# carried the same secret, and a hash of a value this short invites the
	# obvious attack.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>X-Telegram-Bot-Api-Secret-Token delete
			}
		}
	}

	# PostgREST.
	#
	# supabase-js calls ${url}/rest/v1/games?select=..., but PostgREST serves
	# tables at the root (/games). handle_path strips the matched prefix, which
	# is exactly what Supabase's own gateway does.
	handle_path /rest/v1/* {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Forwarded-Proto https

			# PASSIVE health checking. PostgREST deliberately ships no container
			# health check -- an ECS health check whose binary is missing reports
			# UNKNOWN forever and hangs the deployment, which cost real time
			# here. Checking at this layer is better anyway: it tests the path
			# traffic actually takes, and it costs no extra requests.
			#
			# Three failures inside 30s takes the upstream out of rotation for
			# 10s, so a restarting container gives fast failures instead of a
			# queue of stuck connections.
			#
			# `unhealthy_status 5xx` was removed here for the same reason it was
			# removed from the functions route below: with a SINGLE upstream,
			# ejection has no peer to shed load onto, so counting application
			# error responses as unhealthiness only widens a fault from the
			# caller who caused it to everybody. On the functions route that was
			# not theoretical -- three malformed bodies took auth down for all
			# players. PostgREST answers most SQL problems with 4xx, so this was
			# less exposed, but the reasoning does not depend on how often it
			# fires.
			#
			# Connection-level failures still count, which is the case this was
			# wanted for. Reinstate the status check at Stage 2, when a second
			# instance makes ejection meaningful.
			fail_duration 10s
			max_fails 3
			unhealthy_latency 10s
		}
	}

	# The functions service: auth, and the operations RLS cannot express.
	#
	# NOTE THE ABSENCE OF `unhealthy_status 5xx`, which used to be here and
	# caused a trivially triggerable outage.
	#
	# MEASURED against live dev, 2026-07-30: three requests with an unparseable
	# body -- literally `--data-binary '7'` -- returned 500 each (the body parser
	# threw and the generic handler called it a server error). That hit
	# max_fails 3, this upstream left rotation for fail_duration 10s, and the
	# next request from ANY player got 503. Repeat every ten seconds and nobody
	# can log in, from one caller, with no credentials and no volume.
	#
	# The 500 was fixed at the source -- a malformed body is now a 400, see
	# services/functions/src/http-errors.js -- but the amplifier should go too,
	# because it cannot do its job here. Taking an upstream out of rotation sheds
	# load onto a healthy peer. There IS no peer: one instance, one container.
	# So ejection cannot help, and converts an error affecting one caller into an
	# outage affecting everybody.
	#
	# What remains still does the useful part. Caddy detects a refused connection
	# or a dead process on its own and fails fast without being told to watch
	# status codes, which is the case the passive check was actually wanted for.
	#
	# REINSTATE THIS AT STAGE 2. With two instances behind an ALB, ejecting an
	# unhealthy one is exactly right, because then there is somewhere else to go.
	handle_path /functions/v1/* {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Forwarded-Proto https

			fail_duration 10s
			max_fails 3
			unhealthy_latency 10s
		}
	}

	# Cheap liveness probe that touches no upstream, so it stays useful while
	# diagnosing an upstream that is down.
	handle /healthz {
		respond "ok" 200
	}

	handle {
		respond "Fanos Bingo API" 200
	}
}

# ---------------------------------------------------------------------------
# The Mini App itself
#
# Served from here rather than S3 + CloudFront, deliberately. This stack's whole
# shape is "Cloudflare is the CDN, one instance is the origin" -- no ALB, no NAT,
# no WAF. Putting CloudFront behind Cloudflare would be a second CDN in front of
# the first, which is exactly what the apex records avoid, plus an ACM
# certificate and DNS validation for no benefit at this size.
#
# The build is baked into the image, so a deploy is one artifact with one version
# and a rollback is re-deploying an older tag. Cloudflare caches the hashed
# assets at its edge, so an instance replacement does not blank the app for
# everyone -- only for whoever misses the cache during those few minutes.
#
# Revisit at Stage 2: once there is a second instance, or once the app must stay
# up while the origin is down, S3 + CloudFront becomes worth its complexity.
# ---------------------------------------------------------------------------
https://app.{$DOMAIN}:{$HTTPS_PORT:443} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	log {
		output stdout
		format json
	}

	root * /srv/app

	# Hashed filenames, so the content at a given URL can never change. A year is
	# the conventional maximum and `immutable` stops revalidation entirely.
	# Vite emits `index-RO1vvAQ2.js` -- a HYPHEN before the hash, not a dot. An
	# earlier version of this matcher expected a dot and therefore matched
	# nothing, so every asset was served with no cache header at all. It looked
	# correct and quietly cost a full re-download on every visit.
	@hashed path_regexp [-.][0-9a-zA-Z_-]{8,}\.(js|css|woff2?|png|jpe?g|svg|webp|avif)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# index.html must NOT be cached. It is the file that names the current
	# bundle, so a stale copy pins players to an old build indefinitely -- the
	# classic way a deploy appears to do nothing for some users and not others.
	@html path *.html /
	header @html Cache-Control "no-cache, must-revalidate"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# No X-Frame-Options / frame-ancestors: a Telegram Mini App is loaded
		# inside Telegram's own webview, and denying framing would break it.
		-Server
	}

	# SPA routing: unknown paths are client-side routes, not 404s. try_files
	# falls back to index.html so a deep link works on first load.
	try_files {path} /index.html
	file_server
}

# ---------------------------------------------------------------------------
# Realtime
#
# Two rewrites here are mandatory, and both were established by running the
# image locally rather than read from documentation:
#
#   1. PATH. The websocket endpoint is /socket/websocket, not
#      /realtime/v1/websocket. Supabase's own gateway strips that prefix.
#      Without the rewrite: 404.
#
#   2. HOST. Realtime is multi-tenant and resolves the tenant from the host
#      SUBDOMAIN. A request arriving with Host: <ip> gets 403; the same request
#      with Host: realtime-dev.<anything> completes the handshake with 101.
#      The tenant id is created by SEED_SELF_HOST and is `realtime-dev`
#      regardless of environment.
# ---------------------------------------------------------------------------
https://rt.{$DOMAIN}:{$HTTPS_PORT:443} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	log {
		output stdout
		format json
	}

	handle_path /realtime/v1/* {
		rewrite * /socket{path}

		reverse_proxy 127.0.0.1:4000 {
			header_up Host {$REALTIME_TENANT_HOST}
			header_up X-Forwarded-Proto https

			# WebSocket connections are long-lived; the default timeouts would
			# sever an idle game lobby mid-session.
			transport http {
				read_timeout 0
				write_timeout 0
			}

			# Passive health checking, without a latency threshold. A websocket
			# upgrade answers 101 immediately and then stays open for the whole
			# session, so "slow response" is meaningless here -- only an outright
			# failure to answer means anything.
			#
			# `unhealthy_status 5xx` removed here too, completing a change that
			# claimed to cover "both proxied routes" and missed this one -- there
			# are THREE. Found by grepping the DEPLOYED Caddyfile out of the
			# running container and counting, rather than trusting the diff.
			#
			# The reasoning is identical and does not depend on how the upstream
			# behaves: there is one Realtime container, so taking it out of
			# rotation has nowhere to send traffic instead. It converts errors
			# affecting some callers into 503 for every player with a game open.
			#
			# It is if anything more exposed here than on the routes where this
			# was actually measured. Realtime runs its Ecto migrations on boot and
			# can answer 5xx for a few seconds while doing so, which is exactly
			# when a self-inflicted ten-second ejection helps least.
			#
			# Reinstate at Stage 2, with the other two.
			fail_duration 10s
			max_fails 3
		}
	}

	handle /healthz {
		respond "ok" 200
	}

	handle {
		respond "Fanos Bingo Realtime" 200
	}
}
